mach create
machine LoadPlatformDescription @/opt/firmware-sim/renode/platforms/stm32g491.repl
python "g = monitor.Machine[\"sysbus.gpio\"]; g.DrivePin(32, True); g.DrivePin(33, False); g.WriteDoubleWord(0x800, 16); g.WriteDoubleWord(0x814, 4); assert g.ReadDoubleWord(0x810) & 7 == 5; g.Reset(); assert g.ReadDoubleWord(0x800) == 0; assert g.ReadDoubleWord(0x814) == 0; g.WriteDoubleWord(0x80c, 5); assert g.ReadDoubleWord(0x810) & 3 == 1; g.ReleasePin(33); assert g.ReadDoubleWord(0x810) & 3 == 3; g.DrivePin(8, True); g.DrivePin(9, True); g.WriteDoubleWord(0, (2 << 16) | (2 << 18)); g.WriteDoubleWord(4, 0x300); assert g.ReadDoubleWord(0x14) == 0; assert g.ReadDoubleWord(0x10) & 0x300 == 0x300; g.DrivePin(8, False); assert g.ReadDoubleWord(0x10) & 0x300 == 0x200; g.WriteDoubleWord(0, (1 << 16) | (1 << 18)); assert g.ReadDoubleWord(0x10) & 0x300 == 0; g.WriteDoubleWord(0x18, 0x300); assert g.ReadDoubleWord(0x10) & 0x300 == 0x200; print(\"GPIO_EXTERNAL_INPUT_RESET_PASS\")"
quit
