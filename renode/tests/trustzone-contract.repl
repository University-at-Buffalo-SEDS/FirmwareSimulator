nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 160000000
    IRQ -> cpu@0
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic
    numberOfMPURegions: 16
    enableTrustZone: true
    numberOfSAURegions: 8
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x1000
ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x1000
