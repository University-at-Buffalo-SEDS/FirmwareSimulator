{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEDS firmware simulator board layout",
  "type": "object",
  "required": ["name", "architecture", "mcu", "memory", "artifacts"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "architecture": {"enum": ["stm32", "stm32g4", "stm32h5", "stm32u5"]},
    "mcu": {"type": "string", "pattern": "^stm32[a-z0-9]+$"},
    "mcu_descriptor": {
      "type": "object",
      "required": ["name", "architecture", "core_model", "platform_file", "flash_profile", "flash_base", "flash_size", "ram_base", "ram_size", "erase_size", "write_alignment", "trustzone_capable"],
      "properties": {
        "name": {"type": "string", "pattern": "^stm32[a-z0-9]+$"},
        "architecture": {"enum": ["stm32", "stm32g4", "stm32h5", "stm32u5"]},
        "core_model": {"type": "string", "pattern": "^cortex-m[a-z0-9+.-]+$"},
        "platform_file": {"type": "string", "minLength": 1},
        "platform_from_firmware": {"type": "boolean"},
        "flash_profile": {"enum": ["stm32g4", "stm32h5", "stm32u5"]},
        "flash_base": {"type": "integer", "minimum": 0},
        "flash_size": {"type": "integer", "minimum": 1},
        "ram_base": {"type": "integer", "minimum": 0},
        "ram_size": {"type": "integer", "minimum": 1},
        "erase_size": {"type": "integer", "minimum": 1},
        "write_alignment": {"type": "integer", "minimum": 1},
        "trustzone_capable": {"type": "boolean"},
        "uart_ota": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "can_ota": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "usb_ota": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sdmmc_ota": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "board_validated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["flash_base", "flash_size", "ram_regions", "bootloader_size", "slot_a_base", "slot_a_size", "erase_size", "write_alignment", "sedsnet_pool"],
      "properties": {
        "flash_base": {"type": "integer", "minimum": 0},
        "flash_size": {"type": "integer", "minimum": 1},
        "ram_regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "base", "size"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
              "base": {"type": "integer", "minimum": 0},
              "size": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "bootloader_size": {"type": "integer", "minimum": 1},
        "slot_a_base": {"type": "integer", "minimum": 0},
        "slot_a_size": {"type": "integer", "minimum": 1},
        "slot_b_base": {"type": "integer", "minimum": 0},
        "slot_b_size": {"type": "integer", "minimum": 1},
        "delta_base": {"type": "integer", "minimum": 0},
        "delta_size": {"type": "integer", "minimum": 1},
        "persistent_data_base": {"type": "integer", "minimum": 0},
        "persistent_data_size": {"type": "integer", "minimum": 1},
        "erase_size": {"type": "integer", "minimum": 1},
        "write_alignment": {"type": "integer", "minimum": 1},
        "sedsnet_pool": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["elf", "bootloader_elf", "firmware", "bootloader", "factory"],
      "properties": {
        "elf": {"type": "string", "minLength": 1},
        "bootloader_elf": {"type": "string", "minLength": 1},
        "firmware": {"type": "string", "minLength": 1},
        "bootloader": {"type": "string", "minLength": 1},
        "factory": {"type": "string", "minLength": 1},
        "updated_firmware": {"type": "string", "minLength": 1},
        "ota": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "virtual_time_ms": {"type": "integer", "minimum": 1},
        "trace": {"type": "boolean"},
        "boot_success_symbol": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "factory_boot_success_symbol": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "sample_count": {"type": "integer", "minimum": 1},
        "memory_probe_warmup_samples": {"type": "integer", "minimum": 0},
        "require_stack_probe": {"type": "boolean"},
        "hal_tick_address": {"type": "integer", "minimum": 0},
        "hal_tick_step": {"type": "integer", "minimum": 1},
        "memory_probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "symbol"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
              "symbol": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
              "minimum": {"type": "integer", "minimum": 0},
              "maximum": {"type": "integer", "minimum": 0},
              "max_end_drop": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "traffic": {
      "type": "object",
      "properties": {
        "iterations": {"type": "integer", "minimum": 1},
        "max_payload": {"type": "integer", "minimum": 1},
        "queue_depth": {"type": "integer", "minimum": 0},
        "immediate_dispatch": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ota": {
      "type": "object",
      "properties": {
        "chunk_size": {"type": "integer", "minimum": 1},
        "firmware_driven": {"type": "boolean"},
        "start_after_ms": {"type": "integer", "minimum": 0},
        "inter_byte_us": {"type": "integer", "minimum": 0},
        "transport": {
          "type": "object",
          "required": ["kind", "peripheral"],
          "properties": {
            "kind": {"enum": ["uart", "can", "usb", "sdmmc"]},
            "peripheral": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
            "can_id": {"type": "integer", "minimum": 0, "maximum": 536870911},
            "mtu": {"type": "integer", "minimum": 1, "maximum": 64},
            "endpoint": {"type": "integer", "minimum": 0, "maximum": 7}
          },
          "additionalProperties": false
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "symbol"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "symbol": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
              "image": {"enum": ["old", "new", "recovery"]}
            },
            "additionalProperties": false
          }
        },
        "power_cuts": {
          "type": "object",
          "properties": {
            "every_flash_operation": {"type": "boolean"},
            "events": {"type": "array", "items": {"enum": ["erase_start", "erase_complete", "program_unit", "option_commit"]}},
            "reboot_time_ms": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": {
        "strict_mmio": {"type": "boolean"},
        "clocks": {"type": "array", "items": {
          "type": "object", "required": ["peripheral", "frequency_hz"],
          "properties": {"peripheral": {"type": "string", "minLength": 1}, "frequency_hz": {"type": "integer", "minimum": 1}},
          "additionalProperties": false
        }},
        "connections": {"type": "array", "items": {
          "type": "object", "required": ["from", "to"],
          "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "active_low": {"type": "boolean"}},
          "additionalProperties": false
        }},
        "pins": {"type": "array", "items": {
          "type": "object", "required": ["gpio", "pin", "initial"],
          "properties": {"gpio": {"type": "string", "minLength": 1}, "pin": {"type": "integer", "minimum": 0}, "initial": {"enum": ["low", "high", "floating"]}},
          "additionalProperties": false
        }},
        "dma_routes": {"type": "array", "items": {
          "type": "object", "required": ["request", "controller", "channel"],
          "properties": {"request": {"type": "string", "minLength": 1}, "controller": {"type": "string", "minLength": 1}, "channel": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        }},
        "security": {
          "type": "object",
          "properties": {
            "trustzone": {"type": "boolean"},
            "secure_regions": {"type": "array", "items": {
              "type": "object", "required": ["name", "base", "size"],
              "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}, "base": {"type": "integer", "minimum": 0}, "size": {"type": "integer", "minimum": 1}},
              "additionalProperties": false
            }}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "peripherals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {"enum": ["imu", "barometer", "gps", "adc", "pressure_transducer", "storage"]},
          "name": {"type": "string", "minLength": 1},
          "model": {"enum": ["neo_m9n", "bmi088", "bmp390", "ltc2990", "stm32_adc", "sd_card"]},
          "bus": {"type": "string", "minLength": 1},
          "failure_every": {"type": "integer", "minimum": 1},
          "disconnect_after": {"type": "integer", "minimum": 0},
          "bits": {"type": "integer", "minimum": 1, "maximum": 16},
          "channels": {"type": "integer", "minimum": 1},
          "max_psi": {"type": "number", "exclusiveMinimum": 0}
          ,"channel_samples": {"type": "array", "items": {"type": "integer", "minimum": 0}}
          ,"noise_lsb": {"type": "integer", "minimum": 0}
          ,"capacity_bytes": {"type": "integer", "minimum": 512, "multipleOf": 512}
        },
        "dependentRequired": {"model": ["bus"], "bus": ["model"]},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
