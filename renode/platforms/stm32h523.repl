nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 250000000
    IRQ -> cpu@0
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic
    numberOfMPURegions: 16
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 250000000
rcc: Miscellaneous.SedsStm32Rcc @ sysbus 0x44020C00
    variant: "h5"
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32System.cs
pwr: Miscellaneous.SedsStm32Pwr @ sysbus 0x44020800
    variant: "h5"
gpio: GPIOPort.SedsStm32GpioBank @ sysbus 0x42020000
    ports: 8
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Gpio.cs
// H5 uses ST's reduced M_CAN integration with a fixed message-RAM layout:
// 28 standard filters, 8 extended filters, and three entries in each RX FIFO,
// TX-event FIFO, and TX FIFO. Generic M_CAN expects firmware to configure a
// layout that is not configurable on H5 and consequently reports TX full.
fdcan1: CAN.SedsStm32H5Fdcan @ sysbus 0x4000A400
    messageRam: fdcan1MessageRAM
    Int0 -> nvic@39
    Int1 -> nvic@40
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32H5Fdcan.cs
fdcan1MessageRAM: Memory.ArrayMemory @ sysbus <0x4000AC00, +0x350>
    size: 0x350
spi1: SPI.STM32H7_SPI @ sysbus 0x40013000
    IRQ -> nvic@55
timer6: Timers.STM32_Timer @ sysbus 0x40001000
    frequency: 250000000
    initialLimit: 0xFFFF
    IRQ -> nvic@49
sdmmc: Storage.SedsStm32Sdmmc @ sysbus 0x46008000
    IRQ -> nvic@79
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Sdmmc.cs
usb: USB.SedsStm32Usb @ sysbus 0x40040000
    variant: "otg_fs"
    IRQ -> nvic@74
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Usb.cs
gpdma: DMA.SedsStm32Gpdma @ sysbus 0x40020000
    channels: 16
    0 -> nvic@29
    1 -> nvic@30
    2 -> nvic@31
    3 -> nvic@32
    4 -> nvic@33
    5 -> nvic@34
    6 -> nvic@35
    7 -> nvic@36
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Gpdma.cs
cache: Memory.SedsStm32Cache @ sysbus 0x40030400
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Cache.cs
syscfg: Miscellaneous.SedsStm32Syscfg @ sysbus 0x44020000
    variant: "h5"
