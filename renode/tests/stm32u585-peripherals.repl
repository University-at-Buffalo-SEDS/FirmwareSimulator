flashBacking: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000
physicalFlash: MTD.SedsStm32FlashController @ sysbus 0x40022000
    flash: flashBacking
    mcu: "stm32u585"
    eraseSize: 0x2000
    writeAlignment: 16
    flashBase: 0x08000000
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Flash.cs
sdmmc1:
    FailureEvery: 3
    DisconnectAfter: 10
adcSmoke: Sensors.SedsStm32Adc @ sysbus 0x42028000
    bits: 14
    channels: 4
    failureEvery: 5
    disconnectAfter: 20
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Adc.cs
