{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEDS linked avionics bay",
  "type": "object",
  "required": ["name", "nodes"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "quantum_seconds": {"type": "number", "exclusiveMinimum": 0},
    "virtual_time_ms": {"type": "integer", "minimum": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "layout", "firmware_root"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "layout": {"type": "string", "minLength": 1},
        "firmware_root": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    }},
    "links": {"type": "array", "items": {
      "type": "object", "required": ["name", "kind", "endpoints"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["can", "uart"]},
        "endpoints": {"type": "array", "minItems": 2, "items": {
          "type": "object", "required": ["node", "peripheral"],
          "properties": {"node": {"type": "string"}, "peripheral": {"type": "string"}},
          "additionalProperties": false
        }}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
