    "command": "MAX_STACK_PAYLOAD=128 SEDSNET_EMBEDDED_SCHEMA_PATH=<absolute valve-schema.json> CARGO_TARGET_DIR=<existing target> CARGO_BUILD_JOBS=2 VB_REPRO_PROTECTED_SD=1 VB_REPRO_SD_BACKLOG=<1,2,3> VB_REPRO_STARTING_BYTES=2448 VB_REPRO_BACKGROUND=heartbeat,status,discovery cargo test --manifest-path <private SDK>/Cargo.toml --offline --no-default-features --features embedded,compact-packet-store[,fair-admission] --test vb_queue_admission -- --nocapture --test-threads=1",
    "service_option": "Set VB_REPRO_SERVICE_BEFORE_CURRENT=1 for a real dispatch between pressure burst and current admission; otherwise no dispatch occurs until all publications are admitted.",
    "literal_abi_case": "VB_REPRO_STARTING_BYTES=512 intentionally models the literal host ABI, capacity2; hosted624 is needed for actual ARM512 capacity3.",
    "sd_backlog_option": "VB_REPRO_SD_BACKLOG=1,2,3: distinct44-byte reliableSD publications; default1; nine-slot matrix asserts all protected receipts plus each background callback."
  },
