nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 160000000
    IRQ -> cpu@0
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic
    numberOfMPURegions: 16
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 160000000
rcc: Miscellaneous.SedsStm32Rcc @ sysbus 0x46020C00
    variant: "u5"
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32System.cs
pwr: Miscellaneous.SedsStm32Pwr @ sysbus 0x46020800
    variant: "u5"
gpio: GPIOPort.SedsStm32GpioBank @ sysbus 0x42020000
    ports: 9
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Gpio.cs
// U5 uses ST's reduced M_CAN integration with a fixed message-RAM layout:
// 28 standard filters, 8 extended filters, and three entries in each RX FIFO,
// TX-event FIFO, and TX FIFO. Generic M_CAN sees the unconfigured full-core
// layout and incorrectly reports that the fixed U5 TX FIFO is full.
fdcan1: CAN.SedsStm32U5Fdcan @ sysbus 0x4000A400
    messageRam: fdcan1MessageRAM
    Int0 -> nvic@39
    Int1 -> nvic@40
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32U5Fdcan.cs
fdcan1MessageRAM: Memory.ArrayMemory @ sysbus <0x4000AC00, +0x350>
    size: 0x350
usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 160000000
    IRQ -> nvic@61
spi2: SPI.STM32SPI @ sysbus 0x40003800
    series: .L5
    IRQ -> nvic@60
timer2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 160000000
    initialLimit: 0xFFFFFFFF
timer6: Timers.STM32_Timer @ sysbus 0x40001000
    frequency: 160000000
    initialLimit: 0xFFFF
    IRQ -> nvic@49
sdmmc1: Storage.SedsStm32Sdmmc @ sysbus 0x420C8000
    IRQ -> nvic@78
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Sdmmc.cs
usb: USB.SedsStm32Usb @ sysbus 0x42040000
    variant: "otg_fs"
    IRQ -> nvic@73
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Usb.cs
gpdma: DMA.SedsStm32Gpdma @ sysbus 0x40020000
    channels: 16
    0 -> nvic@29
    1 -> nvic@30
    2 -> nvic@31
    3 -> nvic@32
    4 -> nvic@33
    5 -> nvic@34
    6 -> nvic@35
    7 -> nvic@36
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Gpdma.cs
cache: Memory.SedsStm32Cache @ sysbus 0x40030400
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Cache.cs
syscfg: Miscellaneous.SedsStm32Syscfg @ sysbus 0x46020000
    variant: "u5"
