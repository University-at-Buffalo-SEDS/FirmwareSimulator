flashBacking: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x80000
physicalFlash: MTD.SedsStm32FlashController @ sysbus 0x40022000
    flash: flashBacking
    mcu: "stm32g491"
    eraseSize: 0x800
    writeAlignment: 8
    flashBase: 0x08000000
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Flash.cs
signalSmoke: Miscellaneous.SedsSignalInverter
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsSignalInverter.cs
    Output -> gpio@1
gpio:
    0 -> signalSmoke@0
gpsSmoke: Sensors.SedsNeoM9N @ spi1
    failureEvery: 3
    disconnectAfter: 10
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsSpiSensors.cs
monitorSmoke: Sensors.SedsLtc2990 @ i2c2 0x4c
    failureEvery: 4
    disconnectAfter: 12
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsLtc2990.cs
adcSmoke: Sensors.SedsStm32Adc @ sysbus 0x50000000
    bits: 12
    channels: 8
    failureEvery: 5
    disconnectAfter: 20
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Adc.cs
