nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 170000000
    IRQ -> cpu@0
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 170000000
rcc: Miscellaneous.SedsStm32Rcc @ sysbus 0x40021000
    variant: "g4"
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32System.cs
pwr: Miscellaneous.SedsStm32Pwr @ sysbus 0x40007000
    variant: "g4"
dma1: DMA.STM32G0DMA @ sysbus 0x40020000
    numberOfChannels: 7
dma2: DMA.STM32G0DMA @ sysbus 0x40020400
    numberOfChannels: 5
dmamux: Miscellaneous.STM32_DMAMUX @ sysbus 0x40020800
    numberOfInputRequestChannels: 128
    numberOfOutputRequestChannels: 16
    numberOfRequestGeneratorChannels: 4
// G4 and L5 use the same fixed-layout FDCAN register/RAM geometry. The
// STM32-specific model is selected so Cube HAL's compact RX register map is
// modeled; generic M_CAN silently misses all G4 receive FIFO accesses.
fdcan1: CAN.STM32_FDCAN @ sysbus 0x40006400
    series: .L5
    messageRam: fdcan1MessageRAM
    Int0 -> nvic@21
    Int1 -> nvic@22
fdcan2: CAN.STM32_FDCAN @ sysbus 0x40006800
    series: .L5
    messageRam: fdcan2MessageRAM
    Int0 -> nvic@86
    Int1 -> nvic@87
fdcan1MessageRAM: Memory.ArrayMemory @ sysbus <0x4000A400, +0x350>
    size: 0x350
fdcan2MessageRAM: Memory.ArrayMemory @ sysbus <0x4000A750, +0x350>
    size: 0x350
uart4: UART.STM32F7_USART @ sysbus 0x40004C00
    frequency: 170000000
    IRQ -> nvic@52
usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 170000000
    IRQ -> nvic@38
usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 170000000
    IRQ -> nvic@37
spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: .L5
    IRQ -> nvic@35
spi2: SPI.STM32SPI @ sysbus 0x40003800
    series: .L5
    IRQ -> nvic@36
i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
timer1: Timers.STM32_Timer @ sysbus 0x40012C00
    frequency: 170000000
    initialLimit: 0xFFFF
    IRQ -> nvic@25
timer2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 170000000
    initialLimit: 0xFFFFFFFF
    IRQ -> nvic@28
timer6: Timers.STM32_Timer @ sysbus 0x40001000
    frequency: 170000000
    initialLimit: 0xFFFF
    IRQ -> nvic@54
usbPma: Memory.MappedMemory @ sysbus 0x40006000
    size: 0x400
usb: USB.SedsStm32Usb @ sysbus 0x40005C00
    variant: "device_pma"
    pma: usbPma
    IRQ -> nvic@20
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Usb.cs
gpio: GPIOPort.SedsStm32GpioBank @ sysbus 0x48000000
    ports: 7
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsStm32Gpio.cs
syscfg: Miscellaneous.SedsStm32Syscfg @ sysbus 0x40010000
    variant: "g4"
