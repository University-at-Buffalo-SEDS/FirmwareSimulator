sensorTestRam: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x1000

flightSensors: Sensors.SedsFlightSensorBus @ spi1
    0 -> exti@39
    1 -> exti@16
    2 -> exti@36
    preinit:
        include @/opt/firmware-sim/renode/peripherals/SedsSpiSensors.cs

spi1:
    DMARecieve -> gpdma@0
    DMATransmit -> gpdma@1
